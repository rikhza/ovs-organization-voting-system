<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>id.uvs</groupId>
    <artifactId>ovs</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>OVS</name>
    <description>Organization Voting System - open-source Java Spring Boot voting platform for organizations.</description>

    <modules>
        <module>libs/common</module>
        <module>apps/api-gateway</module>
        <module>services/identity-service</module>
        <module>services/election-service</module>
        <module>services/voting-service</module>
        <module>services/result-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <uvs.docker.jvm.memory>-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError</uvs.docker.jvm.memory>
    </properties>
</project>
